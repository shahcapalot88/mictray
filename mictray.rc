#include <winver.h>

1 ICON "mictray.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Subhajit Maji"
            VALUE "FileDescription",  "Mic Tray - tray microphone mute control"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MicTray"
            VALUE "LegalCopyright",   "Copyright © 2026 Subhajit Maji. All rights reserved."
            VALUE "OriginalFilename", "MicTray.exe"
            VALUE "ProductName",      "Mic Tray"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
